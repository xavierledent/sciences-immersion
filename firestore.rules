rules_version = '2';

// Règles de sécurité Firestore du site Sciences en immersion.
//
// CE FICHIER N'EST PAS APPLIQUÉ AUTOMATIQUEMENT : c'est une copie de
// référence. Pour qu'une modification compte, la recopier dans la console
// Firebase (Firestore Database → Règles → Publier).
//
// Principe : tout est refusé, sauf ce qui est explicitement permis ci-dessous.

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Qui est connecté ? =====

    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Compte de l'école, adresse vérifiée par Google.
    function isSchool() {
      return request.auth.token.email_verified == true
        && email().matches('.*@cnddinant[.]be');
    }

    // Même liste que FULL_ACCESS_WHITELIST dans access-control.js :
    // modifier les deux ensemble.
    function isWhitelisted() {
      return email() in ['xledent@gmail.com'];
    }

    // Lecture seule sur les données de tous les élèves. Liste des
    // enseignants : un document par enseignant dans la collection
    // `teachers`, nommé par son adresse en minuscules
    // (teachers/xavier.ledent@cnddinant.be). Ajouter ou retirer quelqu'un
    // se fait dans la console, sans toucher à ces règles.
    function isTeacher() {
      return signedIn() && isSchool()
        && exists(/databases/$(database)/documents/teachers/$(email()));
    }

    // Le propriétaire des données : connecté, autorisé sur le site, et c'est
    // bien SON dossier (uid du dossier = son uid Firebase).
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid && (isSchool() || isWhitelisted());
    }

    // ===== users/{uid} : la fiche de l'élève =====

    match /users/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'migratedAt'])
        && request.resource.data.email == request.auth.token.email;
      // Pas de suppression pour l'instant (prévue pour le compte enseignant,
      // entretien de fin d'année).

      // ===== users/{uid}/chapters/{chapterId} : son travail, un document par chapitre =====
      match /chapters/{chapterId} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid)
          // Seulement de vrais identifiants de chapitre (en_year1_bio1…).
          && chapterId.matches('(en_year1|nl_jaar1)_[a-z]+[0-9]+')
          // Seulement les familles de données connues (DATA_FAMILIES dans
          // storage.js), plus les compteurs de suivi et la date. Ajouter une
          // famille dans storage.js = l'ajouter ici aussi.
          && request.resource.data.keys().hasOnly([
               'practiceAnswer', 'practiceSelfAssess', 'practiceLastExercise',
               'practiceLastTouchedLevel', 'qcmBestScore', 'qcmProgress',
               'fitbBest', 'dndBest', 'memoryBest', 'sortingBest',
               'autoevalRating', 'labProgress', 'labResult',
               'stats', 'updatedAt'
             ]);
      }
    }

    // ===== teachers/{email} : la liste des enseignants =====
    // Chacun peut demander SA fiche (le site sait ainsi s'il doit montrer
    // le lien du tableau de bord) ; les enseignants lisent toute la liste.
    // Aucune écriture depuis le site : la liste se gère dans la console.
    match /teachers/{teacherEmail} {
      allow get: if signedIn() && isSchool() && teacherEmail == email();
      allow read: if isTeacher();
    }

    // ===== classes/{classId} : les classes (1C, 1D…) =====
    // Lues et modifiées par les enseignants seulement. `teacher` = adresse
    // d'un enseignant de la liste ; `track` = filière de la classe.
    match /classes/{classId} {
      allow read, delete: if isTeacher();
      allow create, update: if isTeacher()
        && classId.matches('[0-9A-Za-z-]{1,12}')
        && request.resource.data.keys().hasOnly(['teacher', 'track', 'updatedAt', 'updatedBy'])
        && request.resource.data.track in ['en', 'nl']
        && exists(/databases/$(database)/documents/teachers/$(request.resource.data.teacher));
    }

    // ===== students/{email} : la liste des élèves et de leur classe =====
    // Sert à ranger et nommer les élèves dans le tableau de bord, pas à
    // limiter l'accès. Supprimer une fiche ne touche pas au travail de
    // l'élève (users/…). Les élèves n'y ont aucun accès.
    match /students/{studentEmail} {
      allow read, delete: if isTeacher();
      allow create, update: if isTeacher()
        && studentEmail.matches('[a-z0-9._-]+@cnddinant[.]be')
        && request.resource.data.keys().hasOnly(['prenom', 'nom', 'classe', 'updatedAt', 'updatedBy'])
        && request.resource.data.prenom is string && request.resource.data.prenom.size() <= 60
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 60
        && exists(/databases/$(database)/documents/classes/$(request.resource.data.classe));
    }

    // ===== history/{email} : historique reconstitué depuis le Google Sheet =====
    // Écrit par le tableau de bord (import CSV, dashboard-history.js), lu par
    // les enseignants seulement. Ré-importer remplace le document.
    match /history/{studentEmail} {
      allow read, delete: if isTeacher();
      allow create, update: if isTeacher()
        && studentEmail.matches('[a-z0-9._-]+@cnddinant[.]be')
        && request.resource.data.keys().hasOnly(['chapters', 'cutoff', 'importedAt', 'importedBy', 'sourceRows']);
    }

    // ===== Tableau de bord (phase 6) =====
    // L'enseignant lit les chapitres de tous les élèves en une seule requête.
    match /{path=**}/chapters/{chapterId} {
      allow read: if isTeacher();
    }
  }
}
