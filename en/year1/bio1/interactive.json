      "questions": [
        {
          "question": "Why is a complex food web much more stable than a single, straight food chain?",
          "options": [
            "Because if one species disappears, animals usually have alternative food sources.",
            "Because producers at the bottom grow faster when there are more chains.",
            "Because it prevents decomposers from transforming organic matter back into minerals."
          ],
          "correctAnswer": 0
        },
        {
          "question": "An earthworm breaks down fallen dead leaves in a forest soil. What is its ecological role and matter transformation?",
          "options": [
            "Decomposer; transforms dead organic matter into mineral matter",
