      "id": "qcm-2",
      "quizTitle": "Read the diagram",
      "questions": [
        {
          "question": "What is the name of structure 1?",
          "options": [
            "The uterus",
            "The cervix",
            "The vagina",
            "An ovary"
          ],
          "correctAnswer": 0,
          "explanation": "Structure 1 is the <strong>uterus</strong>: its walls are thick and a baby can grow inside."
        },
        {
          "question": "Which structure makes egg cells?",
          "options": [
            "Structure 2",
            "Structure 1",
            "Structure 5",
            "Structure 6"
          ],
          "correctAnswer": 0,
          "explanation": "Structure 2 is an <strong>ovary</strong>. The Fallopian tube (5) only carries the egg cell."
        },
        {
          "question": "Which structure is the narrow bottom of the uterus?",
          "options": [
            "Structure 6",
            "Structure 4",
            "Structure 5",
            "Structure 3"
          ],
          "correctAnswer": 0,
          "explanation": "Structure 6 is the <strong>cervix</strong>. Below it, the vagina (4) leads to the outside of the body."
        },
        {
          "question": "Which structure is the funnel-shaped opening that receives the egg cell?",
          "options": [
            "Structure 3",
            "Structure 5",
            "Structure 6",
            "Structure 1"
          ],
          "correctAnswer": 0,
          "explanation": "Structure 3 is the <strong>Fallopian tube opening</strong>. The egg cell enters the tube here and then moves along it."
        },
        {
          "question": "Structure 5 connects...",
          "options": [
            "an ovary to the uterus",
            "the uterus to the vagina",
            "the vagina to the outside of the body",
            "the two ovaries to each other"
          ],
          "correctAnswer": 0,
          "explanation": "A <strong>Fallopian tube</strong> connects an ovary to the uterus. Fertilization usually happens in it."
        },
        {
          "question": "At birth, through which two structures does the baby leave the body?",
