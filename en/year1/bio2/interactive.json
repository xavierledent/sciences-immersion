      "quizTitle": "Pregnancy and birth",
      "questions": [
        {
          "question": "From week 2 to week 8 of a pregnancy, the future baby is called...",
          "options": [
            "An embryo",
            "A zygote",
            "A fetus",
            "An oocyte"
          ],
          "correctAnswer": 0,
          "explanation": "From week 2 to week 8 it is an <strong>embryo</strong>: it attaches to the uterus and its organs form."
        },
        {
          "question": "From week 9 until birth, the baby is called...",
          "options": [
            "A fetus",
            "An embryo",
            "A zygote",
            "A sperm cell"
          ],
          "correctAnswer": 0,
          "explanation": "From week 9 it looks like a tiny human and starts to move: it is a <strong>fetus</strong>."
        },
        {
          "question": "What is implantation?",
          "options": [
            "The embryo attaches to the wall of the uterus",
            "A sperm cell enters the egg cell",
            "An ovary releases an egg cell",
            "The baby leaves the uterus"
          ],
          "correctAnswer": 0,
          "explanation": "<strong>Implantation</strong> happens a few days after fertilization, when the embryo attaches to the thick lining of the uterus."
        },
        {
          "question": "Which organ connects the mother and the fetus through the umbilical cord?",
          "options": [
            "The placenta",
            "The prostate",
            "The cervix",
            "The ovary"
          ],
          "correctAnswer": 0,
          "explanation": "The <strong>placenta</strong> is linked to the fetus by the umbilical cord."
        },
        {
          "question": "What does the placenta organize?",
          "options": [
            "Exchanges between the blood of the mother and the blood of the fetus",
            "The mixing of the two bloods",
            "The production of egg cells",
            "Menstruation"
          ],
          "correctAnswer": 0,
          "explanation": "The placenta organizes <strong>exchanges</strong> of oxygen, nutrients and waste. The two bloods never mix."
        },
        {
          "question": "Why does a pregnant woman have no menstruation?",
          "options": [
            "The lining of the uterus stays in place",
            "The egg cell leaves the body",
            "The lining is very thin",
            "The ovaries are closed"
          ],
          "correctAnswer": 0,
          "explanation": "If the egg cell is fertilized, the lining <strong>stays in place</strong> and the embryo attaches to it, so there is no menstruation."
        },
        {
          "question": "Fraternal twins start from...",
          "options": [
            "Two egg cells, each fertilized by a sperm cell",
            "One zygote that splits in two",
            "One egg cell and two sperm cells",
            "One egg cell that splits before fertilization"
          ],
          "correctAnswer": 0,
          "explanation": "Fraternal twins come from <strong>two different fertilized egg cells</strong>. Identical twins come from one zygote that splits."
        },
        {
          "question": "A pregnant woman breathes in a harmful substance and it reaches her blood. Why can it also reach the fetus?",
          "options": [
            "Substances in the mother's blood can pass through the placenta",
            "The two bloods mix completely",
            "The fetus breathes air in the uterus",
            "The substance goes through the vagina"
          ],
          "correctAnswer": 0,
          "explanation": "The bloods never mix, but <strong>substances can pass through the placenta</strong>, so a harmful substance can reach the fetus."
        }
      ]
