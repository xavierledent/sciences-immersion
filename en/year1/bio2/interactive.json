      "id": "qcm-1",
      "quizTitle": "The journey of the cells",
      "questions": [
        {
          "question": "Where are sperm cells made?",
          "options": [
            "In the testes",
            "In the prostate",
            "In the vas deferens",
            "In the penis"
          ],
          "correctAnswer": 0,
          "explanation": "Sperm cells are made in the <strong>testes</strong>. The vas deferens only carries them and the prostate adds a liquid."
        },
        {
          "question": "Which tube carries sperm cells from the testes up into the body?",
          "options": [
            "The vas deferens",
            "The urethra",
            "The Fallopian tube",
            "The cervix"
          ],
          "correctAnswer": 0,
          "explanation": "The <strong>vas deferens</strong> carries the sperm cells up toward the urethra. The Fallopian tubes belong to the female system."
        },
        {
          "question": "The prostate and the seminal vesicle add a liquid to the sperm cells. What does this liquid do?",
          "options": [
            "It helps the sperm cells to swim",
            "It makes new sperm cells",
            "It carries the urine",
            "It starts puberty"
          ],
          "correctAnswer": 0,
          "explanation": "The liquid <strong>helps the sperm cells to swim</strong>. The sperm cells themselves are made in the testes."
        },
        {
          "question": "Which organs make egg cells?",
          "options": [
            "The ovaries",
            "The uterus",
            "The Fallopian tubes",
            "The cervix"
          ],
          "correctAnswer": 0,
          "explanation": "Egg cells (oocytes) are made in the <strong>ovaries</strong>. The uterus is where a baby can grow."
        },
        {
          "question": "An egg cell leaves an ovary. What does it enter first?",
          "options": [
            "The Fallopian tube opening",
            "The uterus",
            "The cervix",
            "The vagina"
          ],
          "correctAnswer": 0,
          "explanation": "The egg cell enters the <strong>funnel-shaped opening</strong> of the Fallopian tube, then moves slowly along the tube."
        },
        {
          "question": "Where does fertilization usually happen?",
          "options": [
            "In a Fallopian tube",
            "In the uterus",
            "In the vagina",
            "In an ovary"
          ],
          "correctAnswer": 0,
          "explanation": "A sperm cell meets the egg cell in a <strong>Fallopian tube</strong>. The embryo only reaches the uterus a few days later."
        },
        {
          "question": "What is the very first cell of a new baby called?",
          "options": [
            "The zygote",
            "The embryo",
            "The fetus",
            "The oocyte"
          ],
          "correctAnswer": 0,
          "explanation": "The <strong>zygote</strong> is formed by fertilization. After a few days it has divided into a ball of cells: the embryo."
        },
        {
          "question": "Which two cells join during fertilization?",
          "options": [
            "One sperm cell and one egg cell",
            "Two sperm cells",
            "Two egg cells",
            "One egg cell and one zygote"
          ],
          "correctAnswer": 0,
          "explanation": "Fertilization is the union of <strong>one sperm cell and one egg cell</strong>. The result is the zygote."
        }
      ]
    },
