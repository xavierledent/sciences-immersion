        {
          "question": "What is the layer beneath the soil called?",
          "image": "assets/QCM1.jpg",
          "options": [
            "Subsoil",
            "Soil",
            "Humus",
            "Aquifer"
          ],
          "correctAnswer": 0,
          "explanation": "Under the soil lies the <strong>subsoil</strong>: rocks and mineral materials, with no living things (layer 2 in the picture)."
        },
        {
          "question": "What does soil contain that subsoil does not?",
          "image": null,
          "options": [
            "Living organisms and organic matter",
            "Rocks and minerals",
            "Water only",
            "Nothing — they are identical"
          ],
          "correctAnswer": 0,
          "explanation": "The soil is full of life (roots, worms, insects) and <strong>organic matter</strong> such as humus. The subsoil contains only rocks and minerals."
        },
        {
          "question": "Where do humans extract most of their raw materials, like iron, stone, or oil?",
          "options": [
            "The subsoil",
            "The soil",
            "The atmosphere",
            "The ocean surface"
          ],
          "correctAnswer": 0,
          "explanation": "Iron ore, stone and oil are found deep underground, so they are extracted from the <strong>subsoil</strong> in mines, quarries and wells."
        },
        {
          "question": "What is humus made from?",
          "options": [
            "Dead leaves and decomposed animals",
            "Rocks and minerals",
            "Melted metal",
            "Plastic waste"
          ],
          "correctAnswer": 0,
          "explanation": "<strong>Humus</strong> is the dark organic matter of the soil. It forms when decomposers (like worms and fungi) break down dead leaves and dead animals."
        }
